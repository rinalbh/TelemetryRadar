{
  "name": "telemetryradar",
  "private": true,
  "version": "0.1.0",
  "description": "TelemetryRadar desktop workspace",
  "type": "module",
  "repository": "github:rinalbh/TelemetryRadar",
  "engines": { "node": ">=22.17" },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite dev",
    "build:web": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
