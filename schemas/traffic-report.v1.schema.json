{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telemetryradar.local/schemas/traffic-report.v1.schema.json",
  "description": "Structural contract. Host semantic validation additionally enforces references, combined locator counts, measurement consistency and evidence verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summary",
    "trafficKinds",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "trafficKinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "amount",
          "risk",
          "example",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit",
              "coverage",
              "basis",
              "evidenceRefs"
            ],
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "enum": [
                  "packets",
                  "frame_bytes",
                  "requests",
                  "connections",
                  "events"
                ]
              },
              "coverage": {
                "enum": [
                  "complete",
                  "partial",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "\\S"
                },
                "maxItems": 100
              }
            }
          },
          "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "rationale",
              "evidenceRefs"
            ],
            "properties": {
              "level": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "unknown"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "\\S"
                },
                "maxItems": 100
              }
            }
          },
          "example": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "redacted",
                  "evidenceRefs"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "\\S"
                  },
                  "redacted": {
                    "type": "boolean"
                  },
                  "evidenceRefs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "\\S"
                    },
                    "maxItems": 100
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            "maxItems": 100
          }
        }
      },
      "maxItems": 200
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frames",
          "streams",
          "displayFilter",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxItems": 100
          },
          "streams": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocol",
                "id"
              ],
              "properties": {
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp"
                  ]
                },
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "maxItems": 100
          },
          "displayFilter": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      },
      "maxItems": 2000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "maxItems": 200
    }
  }
}
